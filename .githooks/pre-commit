#!/bin/sh
# Runs rustfmt and clippy before a commit (`make hooks` turns it on).
# `make fmt` fixes the formatting; `git commit --no-verify` skips the check.
set -e
cd "$(git rev-parse --show-toplevel)"
if ! cargo fmt --all -- --check > /dev/null 2>&1; then
    echo "pre-commit: the code isn't formatted; run \`make fmt\` and add the changes" >&2
    exit 1
fi
cargo clippy --quiet --workspace --all-targets --release -- -D warnings
